# ========================================================
# DHARANI HERBBALS - PAYGLOCAL PAYMENT GATEWAY CONFIGURATION
# ========================================================

# Server Port
PORT=5000

# Environment Mode: 'sandbox' | 'production' | 'mock_sandbox'
# - 'sandbox': For development/testing with PayGlocal UAT
# - 'production': Activates live PayGlocal production endpoints & strict fail-fast validation
PAYGLOCAL_ENV=sandbox

# Official PayGlocal Gateway Base URLs:
# - Sandbox: https://api.uat.payglocal.in
# - Production: https://api.payglocal.in
# (Default is automatically selected based on PAYGLOCAL_ENV)
PAYGLOCAL_BASE_URL=https://api.uat.payglocal.in

# PayGlocal Merchant Credentials
# Obtained from PayGlocal Merchant Portal:
# - Production GCC: https://gcc.prod.payglocal.in
# - UAT Sandbox GCC: https://gcc.uat.payglocal.in
PAYGLOCAL_MERCHANT_ID=DHARANI_HERBBALS_SANDBOX_MID
PAYGLOCAL_KEY_ID=dharani_key_id_001

# Merchant RSA 2048-bit Private Key
# Used strictly by this backend server to generate cryptographic JWS signatures (x-gl-token-external)
# NEVER bundle this in the React Native mobile app or commit it to Git!
# Specify either the absolute/relative path to the .pem file OR the inline PEM string:
PAYGLOCAL_PRIVATE_KEY_PATH=
PAYGLOCAL_PRIVATE_KEY_PEM=

# PayGlocal Common Public Certificate
# Downloaded from the PayGlocal GCC KMS portal.
# Used strictly by this backend to verify signatures of inbound webhooks and callbacks from PayGlocal.
# Specify either the path to the certificate file OR the inline PEM string:
PAYGLOCAL_PUBLIC_KEY_PATH=
PAYGLOCAL_PUBLIC_KEY_PEM=

# Return / Callback URL registered with PayGlocal
# In local development: http://localhost:5000/api/payglocal/callback
# In production: Must start with https:// (e.g., https://api.dharaniherbbals.in/api/payglocal/callback)
PAYGLOCAL_CALLBACK_URL=http://localhost:5000/api/payglocal/callback

# React Native App Deep Link Scheme (used to return customer to app after checkout)
APP_DEEP_LINK_SCHEME=dharani://payment-callback

# Dharani Herbbals Main Upstream API for syncing placed orders
UPSTREAM_CHECKOUT_API=https://api.codingboss.in/herbal/checkout/
